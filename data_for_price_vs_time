"""
Multi-day SPX option panel from OptionMetrics (WRDS).

One row per option per day with every Black-Scholes input:
    S, K, T, r, q, plus two kinds of sigma:
      - impl_volatility : OptionMetrics implied vol
      - rv21, rv63      : zero-mean realised vol of the index over the last 21 / 63 trading days
optionid identifies the same contract across days, so each option can be tracked over time.
"""
import wrds
import numpy as np
import pandas as pd
from pathlib import Path

# ---- Settings ----
START = "2023-09-01"
END = "2023-12-29"
SECID = 108105                 # SPX
MIN_DAYS, MAX_DAYS = 7, 365    # maturity window in calendar days
MONEYNESS = (0.8, 1.2)         # keep K/S in this range; set to None to keep everything
MONTHLY_ONLY = False           # True -> standard monthly expiries only (check expiry_indicator values first)
RV_WINDOWS = (21, 63)          # realised-vol windows in trading days
LOOKBACK_DAYS = 120            # extra calendar days of index history so realised vol exists from START
OUT_DIR = Path("source/data")     # relative to the folder you run the script from
OUTFILE = OUT_DIR / f"spx_panel_{START}_{END}.parquet"


# ---- Helpers ----
def query_by_year(db, make_sql, start, end, date_cols=None):
    """Run a query against OptionMetrics' yearly tables and stack the results.
    make_sql(year, start, end) returns the SQL string for one year."""
    start, end = pd.Timestamp(start), pd.Timestamp(end)
    frames = []
    for y in range(start.year, end.year + 1):
        s = max(start, pd.Timestamp(f"{y}-01-01")).date()
        e = min(end, pd.Timestamp(f"{y}-12-31")).date()
        frames.append(db.raw_sql(make_sql(y, s, e), date_cols=date_cols))
    return pd.concat(frames, ignore_index=True)


def realised_vol(close, window):
    """Zero-mean annualised realised vol from daily closes (uses returns up to and including today)."""
    logret = np.log(close).diff()
    return np.sqrt(252 * logret.pow(2).rolling(window).mean())


def interp_rates(df, zc):
    """Interpolate the zero curve to each option's maturity, using the latest curve
    on or before each date. zerocd rates are in %, continuously compounded."""
    curves = {d: (g["days"].to_numpy(), g["rate"].to_numpy()) for d, g in zc.groupby("date")}
    curve_dates = pd.DatetimeIndex(sorted(curves))
    days = df["days"].to_numpy()
    r = np.full(len(df), np.nan)
    for d, idx in df.groupby("date").indices.items():
        k = curve_dates.searchsorted(d, side="right") - 1
        if k < 0:
            continue
        x, y = curves[curve_dates[k]]
        r[idx] = np.interp(days[idx], x, y) / 100
    return r


# ==== Pull data ====
#%%
db = wrds.Connection(wrds_username="kairogers")

# 1. Options (filtered in SQL to keep the download manageable)
monthly_clause = "AND expiry_indicator IS NULL" if MONTHLY_ONLY else ""
opts = query_by_year(db, lambda y, s, e: f"""
    SELECT date, optionid, exdate, cp_flag, strike_price, best_bid, best_offer,
           volume, open_interest, impl_volatility, delta,
           am_settlement, expiry_indicator, forward_price
    FROM optionm.opprcd{y}
    WHERE secid = {SECID}
      AND date BETWEEN '{s}' AND '{e}'
      AND best_bid > 0
      AND best_offer >= best_bid
      AND impl_volatility > 0
      AND exdate - date BETWEEN {MIN_DAYS} AND {MAX_DAYS}
      {monthly_clause}
""", START, END, date_cols=["date", "exdate"])

# 2. Index closes, with extra history before START for realised vol
spot_start = pd.Timestamp(START) - pd.Timedelta(days=LOOKBACK_DAYS)
spot = query_by_year(db, lambda y, s, e: f"""
    SELECT date, close
    FROM optionm.secprd{y}
    WHERE secid = {SECID}
      AND date BETWEEN '{s}' AND '{e}'
""", spot_start, END, date_cols=["date"])

# 3. Zero curves (single table, not split by year)
zc = db.raw_sql(f"""
    SELECT date, days, rate
    FROM optionm.zerocd
    WHERE date BETWEEN '{spot_start.date()}' AND '{END}'
    ORDER BY date, days
""", date_cols=["date"])

# 4. Dividend yields (single table)
div = db.raw_sql(f"""
    SELECT date, rate
    FROM optionm.idxdvd
    WHERE secid = {SECID}
      AND date BETWEEN '{spot_start.date()}' AND '{END}'
""", date_cols=["date"])

db.close()

for name, df in [("opts", opts), ("spot", spot), ("zero curve", zc), ("dividends", div)]:
    if df.empty:
        raise ValueError(f"No {name} data between {START} and {END}")
print(f"Downloaded {len(opts):,} option rows, {len(spot)} index closes")

#%%
# ==== Build the panel ====
spot = spot.sort_values("date").reset_index(drop=True)
rv_cols = []
for w in RV_WINDOWS:
    spot[f"rv{w}"] = realised_vol(spot["close"], w)
    rv_cols.append(f"rv{w}")

panel = opts.merge(spot[["date", "close"] + rv_cols].rename(columns={"close": "S"}),
                   on="date", how="inner")

panel["strike"] = panel["strike_price"] / 1000          # stored x1000
panel["mid"] = (panel["best_bid"] + panel["best_offer"]) / 2
panel["days"] = (panel["exdate"] - panel["date"]).dt.days
panel["T"] = panel["days"] / 365                        # calendar-day convention, as OptionMetrics
panel["moneyness"] = panel["strike"] / panel["S"]

if MONEYNESS is not None:
    lo, hi = MONEYNESS
    panel = panel[panel["moneyness"].between(lo, hi)]

panel = panel.sort_values(["date", "exdate", "strike", "cp_flag"]).reset_index(drop=True)

# Risk-free rate interpolated to each maturity; dividend yield carried forward if a day is missing
panel["r"] = interp_rates(panel, zc)
div = div.sort_values("date").assign(q=lambda d: d["rate"] / 100)[["date", "q"]]
panel = pd.merge_asof(panel.sort_values("date"), div, on="date", direction="backward")

keep = ["date", "optionid", "exdate", "cp_flag", "strike", "S", "moneyness", "days", "T",
        "r", "q", "best_bid", "best_offer", "mid", "impl_volatility", *rv_cols,
        "delta", "volume", "open_interest", "forward_price", "expiry_indicator", "am_settlement"]
panel = panel[keep].sort_values(["optionid", "date"]).reset_index(drop=True)

#%%
# ==== Summary and sanity checks ====
print(f"{len(panel):,} rows | {panel['date'].nunique()} days | "
      f"{panel['optionid'].nunique():,} contracts | {panel['exdate'].nunique()} expiries")

print(panel[["S", "r", "q", "impl_volatility", *rv_cols]].describe().round(4))
print("Missing values:\n", panel[["r", "q", *rv_cols]].isna().sum())

OUT_DIR.mkdir(parents=True, exist_ok=True)
try:
    panel.to_parquet(OUTFILE, index=False)
    print(f"Saved {OUTFILE}")
except ImportError:                       # pyarrow not installed
    csv_out = OUTFILE.with_suffix(".csv")
    panel.to_csv(csv_out, index=False)
    print(f"Saved {csv_out} (pip install pyarrow for parquet)")

# %%