#%%
from pathlib import Path
import pandas as pd
import matplotlib.pyplot as plt
 
from pricing import black_scholes_call, black_scholes_put
 
# ---- Settings ----
DATA_FILE = Path("source/data/spx_panel_2023-09-01_2023-12-29.csv")
OPTIONID = 108105

# Which sigma columns to price with (label shown in legend -> column in the panel)
SIGMAS = {
    "implied vol": "impl_volatility",
    "realised vol, 21d": "rv21",
    "realised vol, 63d": "rv63",
}

# Colours
INK, MUTED, GRID = "#0b0b0b", "#898781", "#e1e0d9"
COLORS = {"impl_volatility": "#2a78d6", "rv21": "#eb6834", "rv63": "#1baf7a"}
 
#%%
# ---- Load ----
if DATA_FILE.suffix == ".parquet":
    panel = pd.read_parquet(DATA_FILE)
else:
    panel = pd.read_csv(DATA_FILE, parse_dates=["date", "exdate"])
panel = panel.sort_values(["optionid", "date"])
 
# ---- Pick a contract ----
if OPTIONID is None:
    stats = panel.groupby("optionid").agg(n_days=("date", "size"), moneyness=("moneyness", "first"))
    longest = stats[stats["n_days"] == stats["n_days"].max()]
    OPTIONID = (longest["moneyness"] - 1).abs().idxmin()   # closest to at-the-money on its first day
 
one = panel[panel["optionid"] == OPTIONID].reset_index(drop=True)
if one.empty:
    raise ValueError(f"optionid {OPTIONID} not in {DATA_FILE}")
info = one.iloc[0]
is_call = info["cp_flag"] == "C"
price_fn = black_scholes_call if is_call else black_scholes_put
 
print(f"optionid {OPTIONID}: {'call' if is_call else 'put'}, K = {info['strike']:.0f}, "
      f"expiry {info['exdate']:%Y-%m-%d}, {len(one)} days of data")
 
# ---- Black-Scholes price for each sigma ----
for col in SIGMAS.values():
    one[f"bs_{col}"] = price_fn(S=one["S"], K=one["strike"], sigma=one[col],
                                r=one["r"], t=one["T"], q=one["q"])
 
#%%
# ---- Plot ----
fig, (ax, ax_s) = plt.subplots(2, 1, figsize=(10, 6.5), sharex=True,
                               gridspec_kw={"height_ratios": [3, 1.2]})
 
# Option prices
ax.fill_between(one["date"], one["best_bid"], one["best_offer"],
                color=MUTED, alpha=0.25, lw=0, label="Bid-ask spread")
ax.plot(one["date"], one["mid"], color=INK, lw=2, label="Market mid")
for label, col in SIGMAS.items():
    ax.plot(one["date"], one[f"bs_{col}"], color=COLORS[col], lw=2,
            ls="--" if col == "impl_volatility" else "-", label=f"BS, {label}")
ax.set_ylabel("Option price (index points)")
ax.set_title(f"SPX {'call' if is_call else 'put'}, K = {info['strike']:.0f}, "
             f"expiry {info['exdate']:%d %b %Y}", loc="left")
ax.legend(frameon=False, ncol=2, fontsize=9)
 
# Underlying, so price moves can be read against the index
ax_s.plot(one["date"], one["S"], color=INK, lw=1.5, label="SPX")
ax_s.axhline(info["strike"], color=MUTED, ls=":", lw=1.5, label="Strike")
ax_s.set_ylabel("Index level")
ax_s.legend(frameon=False, fontsize=9)
 
for a in (ax, ax_s):
    a.grid(axis="y", color=GRID, lw=0.8)
    a.set_axisbelow(True)
    a.spines[["top", "right"]].set_visible(False)
    a.spines[["left", "bottom"]].set_color(MUTED)
    a.tick_params(colors=MUTED, labelcolor="#52514e")
 
fig.autofmt_xdate()
plt.tight_layout()
plt.show()
# %%