#%%
import wrds
import numpy as np
import pandas as pd

START, END = "2023-05-01", "2023-12-15"
YEAR = START[:4]        # tables are split by year (DOESNT WORK WHEN DATES SPAN OVER MULTIPLE YEARS)
SECID = 108105          # SPX
OPTIONID = 155036250    # ID of option you want

#%%
db = wrds.Connection(wrds_username="kairogers")

opt = db.raw_sql(f"""
    SELECT date, optionid, exdate, cp_flag, strike_price, best_bid, best_offer,
           volume, open_interest, impl_volatility, delta,
           am_settlement, expiry_indicator, forward_price
    FROM optionm.opprcd{YEAR}
    WHERE secid = {SECID}
      AND optionid = {OPTIONID}
      AND date BETWEEN '{START}' AND '{END}'
    ORDER BY date
""", date_cols=["date", "exdate"])

# 2. Index level each day
spot = db.raw_sql(f"""
    SELECT date, close
    FROM optionm.secprd{YEAR}
    WHERE secid = {SECID}
      AND date BETWEEN '{START}' AND '{END}'
""", date_cols=["date"])

# 3. Zero curve each day (risk-free rate for different maturities)
zc = db.raw_sql(f"""
    SELECT date, days, rate
    FROM optionm.zerocd
    WHERE date BETWEEN '{START}' AND '{END}'
    ORDER BY date, days
""", date_cols=["date"])

# 4. Dividend yield each day
div = db.raw_sql(f"""
    SELECT date, rate
    FROM optionm.idxdvd
    WHERE secid = {SECID}
      AND date BETWEEN '{START}' AND '{END}'
""", date_cols=["date"])

db.close()

# ---- Attach everything by DATE ----
opt["strike"] = opt["strike_price"] / 1000                  # stored x1000
opt["days"] = (opt["exdate"] - opt["date"]).dt.days
opt["T"] = opt["days"] / 365
opt["mid"] = (opt["best_bid"] + opt["best_offer"]) / 2

# S: that day's index close
opt = opt.merge(spot.rename(columns={"close": "S"}), on="date", how="left")

# q: that day's dividend yield (carries the last value forward if a day is missing)
div["q"] = div["rate"] / 100
opt = pd.merge_asof(opt.sort_values("date"), div[["date", "q"]].sort_values("date"), on="date")

# r: that day's zero curve, interpolated to the option's remaining maturity
curves = {d: g for d, g in zc.groupby("date")}
opt["r"] = [np.interp(n, curves[d]["days"], curves[d]["rate"]) / 100
            for d, n in zip(opt["date"], opt["days"])]

opt.to_csv(f"source/data/single_option_multi_day{START}-{END}.csv", index=False)

