#%%
"""Download daily SPX index levels from OptionMetrics (WRDS) for realised-vol work."""
import wrds
import numpy as np
import pandas as pd

START, END = "2023-10-01", "2024-12-31"   # start ~3 months early so a 60-day window is full by January
SECID = 108105                            # SPX

db = wrds.Connection(wrds_username="kairogers")

# secprd is split into one table per year, so query each year and stack them
spot = pd.concat([
    db.raw_sql(f"""
        SELECT date, close, return
        FROM optionm.secprd{y}
        WHERE secid = {SECID}
          AND date BETWEEN '{max(START, f"{y}-01-01")}' AND '{min(END, f"{y}-12-31")}'
    """, date_cols=["date"])
    for y in range(int(START[:4]), int(END[:4]) + 1)
]).set_index("date").sort_index()

assert spot.index.is_unique, "duplicate dates"

db.close()

#%%
spot["log_return"] = np.log1p(spot["return"])      # simple return -> log return

print(f"{len(spot)} trading days: {spot.index[0].date()} to {spot.index[-1].date()}")
print(spot.head())

spot.to_csv(f"source/data/spx_spot_{START}_{END}.csv")